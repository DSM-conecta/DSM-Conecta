# Servidor HTTP (site + API). Documentação em http://localhost:5000/api/docs
PORT=5000

# Banco de Dados (MongoDB)
MONGODB_URI=mongodb://localhost:27017/dsmconecta

# Segredo que assina os tokens de administrador. Use um valor longo e privado.
# Se ficar vazio, um segredo aleatório é gerado a cada início e todos os
# administradores precisam entrar de novo após reiniciar o servidor.
ADMIN_TOKEN_SECRET=troque-por-um-valor-longo-e-aleatorio

# Broker MQTT (Mosquitto) — canal de telemetria em tempo real
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=dsm-mosquitto
MQTT_PASSWORD=defina-a-senha-criada-no-mosquitto_passwords.txt
# Árvore de tópicos assinada pelo backend
MQTT_TOPICO=dsm/#
# Use false para rodar site/API sem broker
MQTT_HABILITADO=true
